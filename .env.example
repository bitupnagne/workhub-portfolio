# Copy this file to .env and replace values before running Docker Compose.

SERVER_PORT=8080

DB_NAME=workhub
DB_USER=workhub
DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-root-password
# Host port for the database container. Change it when 13307 is already in use.
DB_HOST_PORT=13307

DEPLOY_SYSTEM_URL=http://localhost:9090
DEPLOY_SSO_SHARED_SECRET=change-deploy-sso-secret
ANONYMITY_SECRET=change-anonymity-secret

# Initial password for new accounts and admin resets (12+ characters).
WORKHUB_INITIAL_PASSWORD=change-initial-password

# First super administrator, created once on an empty database.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-super-admin-password
